# Notetime Environment Variables
# Copy this file to .env and update the values

# Database Configuration
# For local development with SQLite (default):
# DATABASE_URL=sqlite:///notetime.db
#
# For Docker with PostgreSQL:
# DATABASE_URL=postgresql://notetime:notetime_dev_password@db:5432/notetime
#
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///notetime.db

# JWT Secret Key - REQUIRED in production
# Generate a secure random key: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-this-in-production

# JWT Algorithm (default: HS256)
ALGORITHM=HS256

# JWT Access Token Expiration in minutes (default: 7 days = 10080 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=10080
